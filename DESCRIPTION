Depends:
    R (>= 4.1)
Imports:
    bslib,
    htmltools,
    markdown,
    reticulate,
    shiny
Suggests:
    testthat (>= 3.0.0)
Config/testthat/edition: 3
SystemRequirements: Python (>= 3.10) and the Python package markitdown,
    installed for example with pip install 'markitdown[all]'.
Config/roxygen2/version: 8.0.0
